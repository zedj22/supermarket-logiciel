# Supermarket Pro Backend Environment Configuration
#
# REQUIRED: Copy this file to .env and fill in ALL values.
# NEVER commit .env to version control.
#
# The application will NOT start without a valid DATABASE_URL.

# Application environment: development | testing | production
APP_ENV=development

# Secret key for application-level security (generate a strong random value)
# R2: in production (DATA_DIR set) these two values are supplied by the
# per-install file <DATA_DIR>\config\secrets.env, generated automatically
# on first start with a CSPRNG and never overwritten afterwards. The
# values here are therefore development placeholders only - APP_ENV=
# production refuses to start while they are still in effect.
APP_SECRET_KEY=change-me-to-a-strong-random-value

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# The application requires a PostgreSQL connection.
# Replace USER and PASSWORD with your actual PostgreSQL credentials.
#
# If you installed PostgreSQL with the default setup:
#   - Default user: postgres
#   - Default port: 5432
#   - You set the password during PostgreSQL installation
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/supermarket_pro

# To create the database, run:
#   createdb supermarket_pro
# Or using psql:
#   CREATE DATABASE supermarket_pro;

# JWT secret key (for Phase 4+ authentication)
JWT_SECRET_KEY=change-me-to-another-strong-random-value

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Server host and port
HOST=127.0.0.1
PORT=8000

# Store name (used in invoice headers)
STORE_NAME=Supermarket Pro

# =============================================================================
# R1 - WRITABLE RUNTIME DATA DIRECTORY (docs/R1_DATA_PATHS.md)
# =============================================================================
# Production installs set DATA_DIR in the PROCESS ENVIRONMENT (installer /
# service wrapper), NOT in this file: the process variable is what tells the
# backend where to find this config file (<DATA_DIR>\config\.env). When
# DATA_DIR is set, every writable path moves out of the install tree:
#   config (.env)  -> <DATA_DIR>\config\
#   license state  -> <DATA_DIR>\license\
#   server id/data -> <DATA_DIR>\data\
#   backups        -> <DATA_DIR>\backups\
#   logs           -> <DATA_DIR>\logs\
# recommended: DATA_DIR=C:\ProgramData\SupermarketPro
#
# When empty (development default) everything keeps its historical
# location next to the backend:
#   .env at <backend>\.env, license at <backend>\data\license,
#   server id at <backend>\data\server_id, backups at <backend>\backups.
# Never point DATA_DIR inside Program Files - the backend must run
# without write permission to the installation directory.
DATA_DIR=

# Log directory. Empty resolves to <DATA_DIR>\logs in production,
# <backend>\logs in development; it is the destination of the rotating
# application log (R2, see below) and of the service stdout/stderr
# redirection.
LOG_DIR=

# =============================================================================
# R2 - PRODUCTION FILE LOGGING (docs/R2_PRODUCTION_RUNTIME.md)
# =============================================================================
# LOG_DIR above is now operational: when file logging is enabled the
# backend writes a rotating structured log straight into it
# (<LOG_DIR>\backend.log by default).
#
# LOG_FILE_ENABLED selects the sink:
#   (empty)  auto - ON when DATA_DIR is set (production), OFF in
#            development (stdout only, unchanged from before R2)
#   1        force the file sink on (useful while developing)
#   0        force it off even in production
LOG_FILE_ENABLED=

# Base file name inside LOG_DIR (bare name, no path separators).
LOG_FILE_NAME=backend.log

# Size-based rotation: after LOG_MAX_BYTES the file is rotated to
# .1, .2 ... and the oldest of LOG_BACKUP_COUNT files is deleted.
# Retained volume is roughly LOG_MAX_BYTES * (LOG_BACKUP_COUNT + 1).
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# =============================================================================
# R3 - POSTGRESQL DISCOVERY / PROVISIONING OVERRIDES
# (docs/R3_POSTGRESQL_PROVISIONING.md)
# =============================================================================
# The R3 provisioning pass locates PostgreSQL by reading, in priority order:
#   1. the overrides below,
#   2. HKLM\SOFTWARE\PostgreSQL\Installations\* (installer registry),
#   3. <root>\*\bin\psql.exe under the known install roots,
#   4. the Windows service list (sc.exe, read-only).
# Leave ALL of them empty on a normal machine - discovery finds the server
# by itself.  They exist for portable installs and for tests.
#
# Discovery is strictly read-only: it never starts, stops, installs or
# reconfigures anything.  The provisioning pass itself only ever creates/
# migrates the database named in DATABASE_URL.
#
# PG_INSTALL_DIR  e.g. C:\Program Files\PostgreSQL\18
#                 -> registry facts are skipped and the bin/data paths are
#                    derived from it (bin\psql.exe, data\postgresql.conf).
# PG_BIN_DIR      e.g. C:\Program Files\PostgreSQL\18\bin
#                 -> only the tool paths are overridden.
# PG_DATA_DIR     e.g. C:\Program Files\PostgreSQL\18\data
#                 -> only the data directory (and the port read from
#                    postgresql.conf) is overridden.
# PG_SERVICE_NAME e.g. postgresql-x64-18
#                 -> only the service state/account is looked up.
# PG_PORT         e.g. 5432
#                 -> only the advertised port is overridden.
#
# R3_ALLOW_POSTGRESQL_INSTALL is deliberately NOT settable from this file:
# the dedicated-install adapter additionally requires execute=True and a
# SHA-256-verified installer plus an explicit command runner.
PG_INSTALL_DIR=
PG_BIN_DIR=
PG_DATA_DIR=
PG_SERVICE_NAME=
PG_PORT=

# =============================================================================
# PHASE 16 - LAN / MULTI-PC (all default to single-PC behaviour)
# =============================================================================
# LAN_MODE=1 enables the device guard: every /api/v1 call (outside the
# explicit allowlist) must present X-Device-ID + X-Device-Token issued by
# the pairing/approval flow.  Leave it 0 for a single-PC install.
LAN_MODE=0

# DISCOVERY_ENABLED=1 starts the UDP discovery responder (Phase 16).
# Discovery carries NO secrets - only server_id, store name and port.
DISCOVERY_ENABLED=0

# UDP discovery port.  Defaults to the SAME NUMBER as PORT (8000) so the
# store firewall only ever needs one number open.  Configurable.
DISCOVERY_PORT=8000

# Stable server identity used by clients to verify they are talking to the
# store they paired with.  Auto-generated into SERVER_ID_FILE on first start
# when empty.  Not a secret.  R1: SERVER_ID_FILE is always resolved to an
# absolute path - <DATA_DIR>\data\server_id (production) or
# <backend>\data\server_id (development) - never relative to the CWD.
SERVER_ID=
SERVER_ID_FILE=data/server_id

# -----------------------------------------------------------------------------
# LAN deployment (server PC) - documented launch, NOT a WAN exposure:
#   set LAN_MODE=1 DISCOVERY_ENABLED=1
#   uvicorn app.main:app --host 0.0.0.0 --port 8000
# Never forward the service port to the Internet (owner Q5).
# -----------------------------------------------------------------------------

# =============================================================================
# LICENSING (Phase L0 foundations + Phase L1 trial + Phase L2-B lifetime -
# see docs/LICENSING_SYSTEM_ARCHITECTURE_AUDIT_v2.md and
# docs/R4_PRODUCTION_LICENSING.md)
# =============================================================================
# LICENSE_ENFORCEMENT selects the router-level license guard mode:
#   off   (development default) - guard is a complete no-op; behaviour
#                     identical to builds without licensing. No request is
#                     altered, no state file is read, no error is produced.
#   trial (Phase L1)- the Free Trial engine enforces the approved
#                     10-calendar-day trial: business routes and backup
#                     creation return 403 trial_expired once expired,
#                     backup list/download stay available, upload/restore
#                     are 403 during the trial, a missing trial is
#                     403 license_required and an unverifiable trial is
#                     503 license_status_unavailable - never fail open.
#                     A Lifetime license is NOT consulted in this mode.
#   on    (Phase L2-B) - combined decision: a valid Lifetime license admits
#                     every business route; otherwise the trial rows above
#                     apply. Never fail open on a licensing question.
#
# R4 (production only): when APP_ENV=production and this key is omitted
# entirely, the backend falls back to "trial" - never "off" - and logs a
# startup warning whenever "off" is explicitly active in production. An
# explicit value is always honoured here. The production template
# (production.env.example) ships LICENSE_ENFORCEMENT=trial.
LICENSE_ENFORCEMENT=off

# Directory for file-based license/trial state. Kept OUTSIDE PostgreSQL so
# pg_dump backups/restores can never carry (or resurrect) licensing state.
# Empty resolves to <backend>\data\license (development) or
# <DATA_DIR>\license (production, R1). Always absolute. Not a secret.
LICENSE_STATE_DIR=

# Trial length in calendar days, counted from the first backend start
# (Phase L1: 10 days / 240 elapsed hours). Minimum 1.
TRIAL_DAYS=10
