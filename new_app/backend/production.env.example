# Supermarket Pro — PRODUCTION configuration template (R4)
#
# This is the template for the installer-written file:
#
#     <DATA_DIR>\config\.env          (example: C:\ProgramData\SupermarketPro\config\.env)
#
# It is NOT read automatically.  The backend loads exactly one dotenv
# file (see app/core/config.py::resolve_env_file):
#     DATA_DIR set      -> <DATA_DIR>\config\.env     (this file)
#     DATA_DIR unset    -> <backend>\.env             (development, unchanged)
# Copy the values below into <DATA_DIR>\config\.env when building the
# installer; development keeps using .env as it always has.
#
# R1: DATA_DIR itself comes from the PROCESS environment (installer /
# service wrapper), never from this file.
# R2: APP_SECRET_KEY / JWT_SECRET_KEY are deliberately absent - the
# launcher generates them once into <DATA_DIR>\config\secrets.env and a
# production start rejects the repository placeholders outright.
# R3: the database password lives in <DATA_DIR>\config\database.env
# (see docs/R3_POSTGRESQL_PROVISIONING.md); it is never written here and
# never logged.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production

# Must be replaced with a unique value on every deployment. A production
# start fails closed if this is still a repository placeholder.
# (Prefer leaving it out entirely and letting the R2 launcher generate it.)
# APP_SECRET_KEY=

# Database connection for the APPLICATION role - not the PostgreSQL
# superuser.  R3: the superuser/maintenance credential is supplied to the
# provisioning pass through PG_ADMIN_URL and must never appear here.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/supermarket_pro

# ---------------------------------------------------------------------------
# Licensing (R4 - docs/R4_PRODUCTION_LICENSING.md §3)
# ---------------------------------------------------------------------------
# LICENSE_ENFORCEMENT selects the router-level license-guard mode:
#
#   off   - complete no-op: no request is altered, no licensing state is
#           read, current behaviour is bit-for-bit unchanged. This is the
#           DEVELOPMENT default. In production it is legal but must be a
#           deliberate choice: if this key is omitted entirely while
#           APP_ENV=production, the backend falls back to "trial" (never
#           "off"), and a startup warning is logged whenever "off" is
#           active in production.
#
#   trial - the Free Trial engine (default in this template): the
#           approved 10-calendar-day trial gates business routes.
#           Expired -> 403 trial_expired; missing state ->
#           403 license_required; unverifiable state ->
#           503 license_status_unavailable.  A Lifetime license is NOT
#           consulted in this mode (frozen Phase L1 semantics), so
#           activation codes still install and persist but do not open
#           business routes until the mode is raised to "on".
#
#   on    - Phase L2-B combined decision: a valid Lifetime license (or an
#           active trial) admits business routes; without one the typed
#           refusals above apply. This is the mode a billing release
#           ships with (audit §12 Phase L5 target).
#
# Never treat "cannot tell" as "licensed".
LICENSE_ENFORCEMENT=trial

# Free Trial length in calendar days, counted from the first backend start
# (approved: 10 days / 240 elapsed hours, audit D2). Not configurable per
# customer beyond this value; minimum 1.
TRIAL_DAYS=10

# File-based licensing state directory. Leave empty: it resolves to
# <DATA_DIR>\license. Deliberately OUTSIDE PostgreSQL so a pg_dump backup
# or restore can never carry licensing state.
LICENSE_STATE_DIR=

# Packaged PUBLIC verification keys (public Ed25519 keys only - never a
# private key, never written at runtime). Leave empty: it resolves to
# app\licensing\verification_keys.json inside the application package.
LICENSE_VERIFICATION_KEYS_FILE=

# ---------------------------------------------------------------------------
# Paths and logging (R1 / R2)
# ---------------------------------------------------------------------------
# Leave LOG_DIR empty to resolve to <DATA_DIR>\logs.
LOG_DIR=
LOG_FILE_ENABLED=
LOG_FILE_NAME=backend.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# ---------------------------------------------------------------------------
# LAN / discovery - off on a single-PC install
# ---------------------------------------------------------------------------
LAN_MODE=0
DISCOVERY_ENABLED=0
DISCOVERY_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL discovery overrides (R3) - leave empty on a normal machine
# ---------------------------------------------------------------------------
PG_INSTALL_DIR=
PG_BIN_DIR=
PG_DATA_DIR=
PG_SERVICE_NAME=
PG_PORT=

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------
SERVER_ID=
SERVER_ID_FILE=data/server_id
STORE_NAME=Supermarket Pro
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
