# KlickPOS License Dashboard — Cloud Run environment template.
#
# PLACEHOLDERS ONLY. Every NEXT_PUBLIC_* value is compiled into the browser
# bundle by design (a Firebase Web App config is public); nothing else may be
# named NEXT_PUBLIC_*.

# --- proxy target (SERVER-ONLY) ------------------------------------------- #
# The API's Cloud Run URL, read by the server-side proxy on every request. The
# browser calls the same-origin /api/license/* path and never needs this URL.
# No NEXT_PUBLIC_ prefix by design: Next.js inlines those at build time, which
# would bake one environment's API URL into the image.
LICENSE_API_BASE_URL=https://<api-service>-<hash>-<region>.a.run.app
# Build-time compatibility fallback (Phase 6). Leave empty for new deployments —
# prefer LICENSE_API_BASE_URL above.
NEXT_PUBLIC_API_BASE_URL=

# --- Cloud Run service identity ------------------------------------------- #
# The same API URL, used as the OIDC audience this service mints its identity
# token for. Server-only (deliberately NOT NEXT_PUBLIC). Empty disables the
# service identity and is only correct for a local run.
LICENSE_DASHBOARD_API_AUDIENCE=https://<api-service>-<hash>-<region>.a.run.app

# --- Firebase Web App (public configuration) ------------------------------ #
# These are BUILD arguments: Next.js inlines them into the browser bundle, so
# they must be passed as `docker build --build-arg …`. `prebuild` refuses to
# build when the first four are missing. See docs/render-staging.md §4.
NEXT_PUBLIC_FIREBASE_API_KEY=<web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<gcp-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<web-app-id>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
# Must stay unset/empty in Cloud Run: it accepts unsigned emulator tokens.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# --- Firebase App Check (public site key) ---------------------------------- #
# reCAPTCHA Enterprise key for this web app. Required once the API sets
# LICENSE_API_REQUIRE_APP_CHECK=1; the browser mints the token and sends it as
# X-Firebase-AppCheck, which the API verifies server-side.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=<recaptcha-enterprise-site-key>
# Development only. Must be empty in staging and production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
