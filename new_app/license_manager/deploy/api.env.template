# KlickPOS License API — Cloud Run environment template.
#
# PLACEHOLDERS ONLY. No real value belongs in this file, and it is never the
# source of a secret: the two secrets below are *names* in Secret Manager, and
# the values are read at runtime with the service's own identity.
#
#   gcloud run deploy ... --env-vars-file deploy/api.env.template
#
# (Rename to a local, git-ignored copy first; keep that copy out of the image.)

# --- identity of this deployment ------------------------------------------ #
LICENSE_API_ENV=production
LICENSE_API_FIREBASE_PROJECT_ID=<gcp-project-id>
# Empty means the (default) Firestore database.
LICENSE_API_FIRESTORE_DATABASE=
# Absolute path inside the image; the packaged customer keys ship with it.
LICENSE_API_VERIFICATION_KEYS_FILE=/app/backend/app/licensing/verification_keys.json

# --- administrator allowlist (never empty) -------------------------------- #
LICENSE_API_ADMIN_UIDS=<firebase-admin-uid>
LICENSE_API_ADMIN_EMAILS=<admin-email>

# --- Where secret VALUES come from (names, never values) ------------------ #
# `secretmanager` is the default and is what Cloud Run uses; nothing changes
# here for production. `file` reads one file per secret name from
# LICENSE_API_SECRET_DIR, for hosts without Secret Manager (Render Free /
# Firebase Spark). A typo in the value stops the process at startup.
LICENSE_API_SECRET_SOURCE=secretmanager
# Only used when the source above is `file`; leave empty for Secret Manager.
LICENSE_API_SECRET_DIR=

# --- Secret Manager names (values are read at runtime) -------------------- #
LICENSE_API_SIGNING_SECRET=LICENSE_API_SIGNING_SECRET
LICENSE_API_SIGNING_SECRET_VERSION=<version-number>
LICENSE_API_CODE_ENC_SECRET=LICENSE_API_CODE_ENC_SECRET
LICENSE_API_CODE_ENC_SECRET_VERSION=<version-number>

# --- Dashboard → API service authentication ------------------------------- #
# Cloud Run IAM is the outer gate; the API repeats the check in-process.
LICENSE_API_REQUIRE_CLOUD_RUN_INVOKER=1
# The API's own Cloud Run URL — the audience the Dashboard mints its token for.
LICENSE_API_CLOUD_RUN_AUDIENCE=https://<api-service>-<hash>-<region>.a.run.app
# Exactly the Dashboard runtime service account (comma separated if more).
LICENSE_API_CLOUD_RUN_INVOKERS=<dashboard-runtime-sa>@<gcp-project-id>.iam.gserviceaccount.com

# --- App Check ------------------------------------------------------------ #
# Leave 0 until the dashboard sends a verified App Check token (see
# docs/cloud-run.md §App Check). Turning it on early locks every admin out.
LICENSE_API_REQUIRE_APP_CHECK=0
# Firebase project *number* (Console → Project settings). App Check tokens carry
# `aud = projects/<number>`. Required when the flag above is 1 in production:
# the service refuses to start rather than accept tokens for an unpinned project.
LICENSE_API_APP_CHECK_AUDIENCE=<firebase-project-number>

# --- limits, proxy, logs -------------------------------------------------- #
# Cloud Run's front end is the only path into the container, so the forwarded
# address is trustworthy here (and only here).
LICENSE_API_TRUST_PROXY=1
LICENSE_API_RATE_LIMIT_PER_MINUTE=60
LICENSE_API_ISSUE_LIMIT_PER_MINUTE=20
LICENSE_API_MAX_BODY_BYTES=8192
LICENSE_API_LOG_JSON=1
