# --------------------------------------------------------------------------- #
# KlickPOS License Manager — STAGING on Render Free (combined container)
#
# PLACEHOLDERS ONLY. No real credential, key, service-account path or hostname
# belongs in this file. Nothing here is a secret *value*: the two signing
# secrets are file names under LICENSE_API_SECRET_DIR, mounted by Render.
#
# This template describes ONE container that serves Next.js on Render's $PORT
# and FastAPI on 127.0.0.1:8000, built from license_manager/Dockerfile.render
# with `new_app/` as the build context (see ../docs/render-staging.md §10).
#
# Two distinct groups below, and they are applied at different times:
#   A. PUBLIC BUILD ARGUMENTS — Next.js inlines these at `docker build`.
#   B. RUNTIME ENVIRONMENT    — read by the container at start.
# --------------------------------------------------------------------------- #

# =========================================================================== #
# A. Public Firebase web configuration — BUILD ARGUMENTS
#    Firebase Console → Project settings → Your apps → KlickPOS-License-Staging
#    → SDK setup and configuration → Config.
#    Public by design. `prebuild` (scripts/public-build-env.mjs) refuses to
#    build when the first four are missing.
# =========================================================================== #
NEXT_PUBLIC_FIREBASE_API_KEY=<staging-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=klickpos-license-free-8029b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=klickpos-license-free-8029b
NEXT_PUBLIC_FIREBASE_APP_ID=<staging-web-app-id>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<staging-project-number>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=klickpos-license-free-8029b.firebasestorage.app
# Empty until App Check is registered for the Render hostname (see §5 of
# docs/render-staging.md). An empty value only means "send no App Check token".
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Must stay empty: a baked debug token silently bypasses App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Must stay empty: it makes Firebase accept unsigned emulator tokens.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
# Legacy build-time fallback only. Leave empty: the proxy target is the
# server-only LICENSE_API_BASE_URL below, read at request time.
NEXT_PUBLIC_API_BASE_URL=

# =========================================================================== #
# B. Runtime environment
# =========================================================================== #

# --- License API identity -------------------------------------------------- #
LICENSE_API_ENV=production
LICENSE_API_FIREBASE_PROJECT_ID=klickpos-license-free-8029b
# Empty means the (default) Firestore database — which is what staging uses.
LICENSE_API_FIRESTORE_DATABASE=
# STAGING public keys ONLY — never the packaged production file. The staging
# key id (stg-2026-11) is published in this file and nowhere else; production
# keys stay in backend/app/licensing/verification_keys.json and are never
# referenced, mounted or copied here. The image must carry this path (see
# docs/render-staging.md §3.1).
LICENSE_API_VERIFICATION_KEYS_FILE=/app/license_manager/deploy/staging/verification_keys.staging.json
# Fail closed when that path is unset, mistyped or resolves back to the
# packaged production keys: the service refuses to start rather than silently
# issuing codes no staging client can verify.
LICENSE_API_REQUIRE_STAGING_KEYS=1
# The keys file proves the *public* half; this proves the mounted signing seed is
# the matching private half. Startup derives the Ed25519 public key from the seed
# and compares it (constant time) with the key published above, failing closed on
# a missing, malformed or mismatched seed. Staging-only: production leaves it off.
LICENSE_API_REQUIRE_SIGNING_KEY_MATCH=1

# --- Secrets: read-only mounted files, not Secret Manager ------------------ #
# Render has no Google Secret Manager and Firebase Spark does not provide one.
# One file per secret name inside this directory:
#   <dir>/LICENSE_API_SIGNING_SECRET     {"key_id": "...", "seed_b64": "..."}
#   <dir>/LICENSE_API_CODE_ENC_SECRET    base64 of exactly 32 bytes
# Version variables are ignored by the file source (names carry no version).
LICENSE_API_SECRET_SOURCE=file
LICENSE_API_SECRET_DIR=/etc/secrets
LICENSE_API_SIGNING_SECRET=LICENSE_API_SIGNING_SECRET
LICENSE_API_CODE_ENC_SECRET=LICENSE_API_CODE_ENC_SECRET

# --- Staging administrator allowlist (fill before first sign-in) ----------- #
# Both empty means every request is refused (fail-closed). The staging UID is
# different from production's even for the same Google account, because
# Firebase UIDs are per project: sign in once, then copy it from
# Authentication → Users. Allowlisting the e-mail as well removes that trap.
LICENSE_API_ADMIN_UIDS=<staging-admin-uid>
LICENSE_API_ADMIN_EMAILS=<staging-admin-email>

# --- Proxy target: SERVER-ONLY, read per request --------------------------- #
# The Next.js Route Handler calls FastAPI on loopback inside this container.
# No NEXT_PUBLIC_ prefix: it must never be inlined into a browser bundle, and
# one image must serve any environment. Plain http is allowed for loopback only.
LICENSE_API_BASE_URL=http://127.0.0.1:8000
# No Cloud Run in this design: the service-identity token cannot be minted and
# must stay empty, or the proxy answers 503 service_identity_unavailable.
LICENSE_DASHBOARD_API_AUDIENCE=

# --- Gates that must stay OFF on Render ------------------------------------ #
# There is no Cloud Run IAM edge and no metadata server here.
LICENSE_API_REQUIRE_CLOUD_RUN_INVOKER=0
# Keep 0 until a dashboard build that sends real App Check tokens is verified
# (see §5). Turning it on before the site key exists locks every admin out.
LICENSE_API_REQUIRE_APP_CHECK=0
# Required only together with the flag above; the staging project *number*.
LICENSE_API_APP_CHECK_AUDIENCE=

# --- Audit-trail address --------------------------------------------------- #
# The proxy forwards only authorization / app-check / content-type / accept /
# x-request-id, so X-Forwarded-For cannot be trusted here. Leave 0.
LICENSE_API_TRUST_PROXY=0

# --- Limits and logs ------------------------------------------------------- #
LICENSE_API_RATE_LIMIT_PER_MINUTE=60
LICENSE_API_ISSUE_LIMIT_PER_MINUTE=20
LICENSE_API_MAX_BODY_BYTES=8192
LICENSE_API_LOG_JSON=1

# --- Google credentials: staging-only mounted service account -------------- #
# Read by google-auth (Firebase Admin + Firestore), never by this repository's
# code and never copied into an image layer. Create it in Phase 8.4.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/<staging-service-account>.json

# =========================================================================== #
# MUST NOT BE SET — the API refuses to start when these are combined with
# LICENSE_API_ENV=production, and the emulator variables would silently accept
# unsigned tokens or write to a laptop database:
#   LICENSE_API_DEV_SIGNING_SEED_B64
#   LICENSE_API_DEV_CODE_ENC_KEY_B64
#   LICENSE_API_DEV_AUTH_UID
#   FIREBASE_AUTH_EMULATOR_HOST
#   FIRESTORE_EMULATOR_HOST
# =========================================================================== #
