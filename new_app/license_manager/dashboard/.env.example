# ---------------------------------------------------------------------------
# KlickPOS License Manager — dashboard configuration
#
# Copy to `.env.local` and fill in. Every value below is PUBLIC by design: it is
# compiled into the browser bundle. Never put a signing seed, an AES key or a
# service-account file here — those live only on the License API.
# ---------------------------------------------------------------------------

# Where the Python FastAPI License API runs (no trailing slash). The browser
# never calls this origin directly: the Route Handler proxies /api/license/* to
# it, so the dashboard stays same-origin and the API needs no CORS.
#
# SERVER-ONLY (no NEXT_PUBLIC_ prefix): the handler reads it per request, so an
# image does not bake in one environment's API URL. `http` is accepted for
# loopback only. Set it at run time, e.g. `LICENSE_API_BASE_URL=http://127.0.0.1:8000`
# in the combined container.
LICENSE_API_BASE_URL=http://127.0.0.1:8000
# Legacy build-time fallback (Phase 6 Cloud Run). Leave empty: a NEXT_PUBLIC_
# value is inlined by Next at build time and cannot be a runtime setting.
NEXT_PUBLIC_API_BASE_URL=

# Firebase Web SDK configuration (Authentication only — Firestore is never
# opened from the browser). Firebase Console → Project settings → General →
# Your apps → Web app → SDK setup and configuration → Config.
# Google is the only administrator sign-in provider; there is no development
# sign-in fallback.
#
# These are BUILD-time values: Next.js inlines them when it compiles, so in a
# container they are passed as `docker build --build-arg`. `prebuild`
# (scripts/public-build-env.mjs) refuses to build when the first four are empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=klickpos-license-manager.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=klickpos-license-manager
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, copied from the same config panel when present.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase App Check (Phase 6.9) ----------------------------------------
# reCAPTCHA Enterprise site key for this web app (Firebase Console → App Check →
# Apps → your web app → Manage providers). PUBLIC by design, like the config
# above. When empty, no App Check token is sent: fine locally, but the API must
# keep LICENSE_API_REQUIRE_APP_CHECK=0 until every deployment sets this.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Local development only: a debug token registered in the Console (App Check →
# Apps → Manage debug tokens), or `true` to let the SDK print a new one. Never
# set this for the staging/production deployment.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: run against the Firebase Auth emulator instead of the real project.
# Example: 127.0.0.1:9099  (the host:port value only). Never set in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# --- Cloud Run service identity (Phase 6) ----------------------------------
# The API's Cloud Run URL, used as the OIDC audience for the service identity
# token this server mints (server-only: never NEXT_PUBLIC_*). Leave empty for a
# local run; on Cloud Run it must equal NEXT_PUBLIC_API_BASE_URL.
LICENSE_DASHBOARD_API_AUDIENCE=
